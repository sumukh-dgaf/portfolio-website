# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Public site URL, used for metadata/canonical/OG tags. Set this to your
# production domain once deployed (e.g. https://yourname.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — only needed if you wire up a working contact form backend
# (e.g. via Resend's free tier at https://resend.com). Not used by default;
# the Contact section currently uses a plain mailto: link and needs no keys.
# RESEND_API_KEY=
